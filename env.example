# Database Configuration
# PostgreSQL connection (compose reads this file from the repo root by default)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=geasgremlin
DB_USER=postgres
DB_PASSWORD=your_password_here

# Backend Configuration
# Docker Compose sets PORT=80 in the container (host maps 8140:80).
# Local `npm run dev` in backend defaults to 8140 so it matches the Vite proxy.
PORT=80

# Note: Copy this file to .env and update with your actual values.
# The geasgremlin database should already exist (migrated from your Firebird system).
