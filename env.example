# Database Configuration
# PostgreSQL connection (compose reads this file from the repo root by default)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=rpghub
DB_USER=postgres
DB_PASSWORD=your_password_here

# Backend Configuration
# Port for the backend service (default: 80, exposed as 8100 in docker-compose)
PORT=80

# Note: Copy this file to .env and update with your actual values.
# The rpghub database should already exist (migrated from your Firebird system).
