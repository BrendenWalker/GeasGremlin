  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "export-ruleset": "node scripts/export-ruleset.js",
    "import-ruleset": "node scripts/import-ruleset.js",
    "import-catalog": "node scripts/import-catalog.js",
    "test:catalog-import": "node scripts/catalogImport.check.js",
    "test:monster-notes": "node scripts/monsterNotes.check.js",
